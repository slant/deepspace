<% content_for :title, @campaign.display_name %>

<div class="flex h-[calc(100vh-3.5rem)] flex-col">
  <% if @campaign.completed? || @campaign.failed? %>
    <% summary = @campaign.journey_summary %>
    <div class="shrink-0 border-b border-space-700 bg-space-800 px-4 py-3 text-space-100">
      <p class="text-center text-sm font-semibold uppercase tracking-wider">
        <%= @campaign.completed? ? "Victory!" : "Failed" %>
      </p>
      <dl class="mt-2 flex flex-wrap justify-center gap-x-6 gap-y-1 text-center font-mono text-xs text-space-400">
        <div><dt class="inline">Moves </dt><dd class="inline text-space-100"><%= summary[:moves] %></dd></div>
        <div><dt class="inline">Sectors </dt><dd class="inline text-space-100"><%= summary[:sectors_discovered] %></dd></div>
        <div><dt class="inline">Items held </dt><dd class="inline text-space-100"><%= summary[:items_collected] %></dd></div>
        <div><dt class="inline">Sequences marked </dt><dd class="inline text-space-100"><%= summary[:sequences_marked] %></dd></div>
        <div><dt class="inline">Officers lost </dt><dd class="inline text-space-100"><%= summary[:officers_lost] %></dd></div>
        <div><dt class="inline">Ended at </dt><dd class="inline text-space-100"><%= summary[:final_position] %></dd></div>
      </dl>
    </div>
  <% end %>

  <div class="flex flex-1 min-h-0 flex-col lg:flex-row overflow-hidden"
       data-controller="event-modal"
       data-event-modal-campaign-id-value="<%= @campaign.public_id %>">
  <aside class="border-b border-space-800 bg-space-900/50 p-4 lg:w-80 lg:border-b-0 lg:border-r"
         data-controller="campaign-hud"
         data-campaign-hud-update-url-value="<%= campaign_path(@campaign, format: :json) %>"
         data-campaign-hud-jump-drive-url-value="<%= jump_drive_campaign_path(@campaign) %>">
    <h1 class="font-display text-lg font-semibold text-cyan-300"><%= @campaign.character.ship_name %></h1>
    <p class="text-sm text-space-400">Captain <%= @campaign.character.name %></p>

    <section class="mt-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-space-400">Officers</h2>
      <ul class="mt-2 space-y-2 text-sm" data-campaign-hud-target="officers">
        <% @campaign.character.officers.each do |officer| %>
          <li class="<%= 'text-space-400 line-through' if officer.dead? %>">
            <span class="text-space-100"><%= officer.name %></span>
            <span class="text-space-400"> — <%= officer.effective_title %>, <%= officer.specialty %></span>
            <div class="text-xs text-space-400/80">
              <%= officer.all_attributes.join(", ") %>
              <% if officer.fatigue_marks.positive? %>
                <div class="mt-1 flex items-center gap-1.5">
                  <span class="text-space-400">Fatigue</span>
                  <div class="relative h-3 w-16 overflow-hidden rounded-sm border border-red-900/60 bg-space-800">
                    <div class="h-full bg-red-500/70" style="width: <%= (officer.fatigue_marks.to_f / officer.fatigue_threshold * 100).round %>%"></div>
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-[10px] leading-none text-space-100"><%= officer.fatigue_marks %>/<%= officer.fatigue_threshold %></span>
                  </div>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <dl class="mt-6 space-y-3 font-mono text-sm">
      <div class="flex justify-between">
        <dt class="text-space-400">Fuel</dt>
        <dd data-campaign-hud-target="fuel"><%= @campaign.fuel %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-space-400">Scrap</dt>
        <dd data-campaign-hud-target="scrap"><%= @campaign.scrap %></dd>
      </div>
      <div>
        <dt class="text-space-400">Position</dt>
        <dd class="mt-1" data-campaign-hud-target="position"><%= @campaign.current_hex_label %></dd>
      </div>
      <div>
        <dt class="text-space-400">Cargo</dt>
        <dd class="mt-1 break-all text-xs leading-relaxed" data-campaign-hud-target="cargo"><%= @campaign.cargo_sequence %></dd>
      </div>
    </dl>

    <button type="button"
            class="btn-secondary mt-3 w-full text-xs <%= 'hidden' unless @campaign.can_jump_drive? %>"
            data-campaign-hud-target="jumpDrive"
            data-action="click->campaign-hud#jumpDrive"
            title="Return to your previous position — costs 1 fuel">
      Jump Drive — Return to Previous Position
    </button>

    <section class="mt-8">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-space-400">Cargo Manifest</h2>
      <ul class="mt-3 space-y-1 text-sm" data-campaign-hud-target="items">
        <% @campaign.items.each do |item| %>
          <li class="<%= 'text-space-400 line-through' if item['lost'] %>">
            [<%= item['name'] %>]
          </li>
        <% end %>
        <% if @campaign.items.empty? %>
          <li class="text-space-400/70 italic" data-campaign-hud-target="itemsEmpty">No items yet</li>
        <% end %>
      </ul>
      <ul class="mt-2 flex flex-wrap gap-1.5" data-campaign-hud-target="sequences">
        <% @campaign.cargo_marks.each do |token, state| %>
          <li class="rounded border border-space-700 bg-space-800 px-1.5 py-0.5 font-mono text-xs <%= state == 'underline' ? 'underline' : 'ring-1 ring-cyan-400/60' %>">
            <%= token %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-space-400">Journal</h2>
      <ul class="mt-3 max-h-48 space-y-2 overflow-y-auto text-sm" data-campaign-hud-target="journal">
        <% @campaign.journal_entries.limit(20).each do |entry| %>
          <li class="border-l-2 border-space-700 pl-3">
            <span class="text-xs text-space-400/70"><%= entry.created_at.strftime("%b %d %H:%M") %></span>
            <p class="text-space-100"><%= entry.body %></p>
          </li>
        <% end %>
      </ul>
      <% if @campaign.active? %>
        <form class="mt-2 flex gap-2" data-controller="journal-note" data-journal-note-url-value="<%= campaign_journal_entries_path(@campaign) %>" data-action="submit->journal-note#submit">
          <input type="text" placeholder="Add a note…" maxlength="500" class="input flex-1 text-xs" data-journal-note-target="input">
          <button type="submit" class="btn-secondary px-3 text-xs">Add</button>
        </form>
      <% end %>
    </section>
  </aside>

  <div class="flex flex-1 flex-col min-h-0">
    <div class="shrink-0 border-b border-space-800 bg-space-900/70"
         data-controller="upgrades-panel"
         data-upgrades-panel-campaign-id-value="<%= @campaign.public_id %>"
         data-upgrades-panel-tracks-value="<%= Campaign::RND_TRACKS.to_json %>"
         data-upgrades-panel-progress-value="<%= @campaign.researched_upgrades.to_json %>"
         data-upgrades-panel-scrap-value="<%= @campaign.scrap %>">
      <button type="button"
              class="flex w-full items-center justify-between px-4 py-2 text-xs font-semibold uppercase tracking-wider text-space-300 hover:text-cyan-300"
              data-action="click->upgrades-panel#toggle">
        <span>Upgrades</span>
        <span data-upgrades-panel-target="chevron" class="transition-transform">▾</span>
      </button>
      <div class="hidden border-t border-space-800 px-4 py-3" data-upgrades-panel-target="panel">
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" data-upgrades-panel-target="tracks"></div>
      </div>
    </div>

    <div class="flex flex-1 flex-col p-4 min-h-0">
      <%= turbo_frame_tag "campaign_map", class: "flex flex-1 flex-col min-h-0" do %>
        <%= render HexMapComponent.new(campaign: @campaign) %>
      <% end %>
    </div>
  </div>

  <div class="modal-backdrop hidden" data-event-modal-target="backdrop" data-action="click->event-modal#close"></div>
  <div class="event-modal hidden" data-event-modal-target="dialog" role="dialog" aria-modal="true">
    <div class="flex items-start justify-between gap-4">
      <h2 class="font-display text-xl font-semibold text-cyan-300" data-event-modal-target="title"></h2>
      <button type="button" class="text-space-400 hover:text-space-100" data-action="click->event-modal#close" aria-label="Close">✕</button>
    </div>
    <div class="mt-4 space-y-3 text-space-300 leading-relaxed" data-event-modal-target="body"></div>
    <div class="mt-6 flex flex-col gap-2" data-event-modal-target="choices"></div>
  </div>
  </div>
</div>
