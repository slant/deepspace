<% content_for :title, "Your Campaigns" %>

<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="font-display text-2xl font-bold text-space-100">Campaigns</h1>
      <p class="mt-1 text-space-400">Continue an adventure or begin a new one.</p>
    </div>
    <%= link_to "New Campaign", new_campaign_path, class: "btn-primary" %>
  </div>

  <ul class="mt-8 space-y-3">
    <% @campaigns.each do |campaign| %>
      <li class="card flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-semibold text-space-100">
            <%= campaign.display_name %>
            <% if campaign.completed? || campaign.failed? %>
              <span class="ml-2 rounded border border-space-700 bg-space-800 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-space-300">
                <%= campaign.completed? ? "Victory" : "Failed" %>
              </span>
            <% end %>
          </h2>
          <p class="mt-1 text-sm text-space-400"><%= campaign.progress_summary %></p>
        </div>
        <div class="flex gap-2">
          <% if campaign.draft? %>
            <%= link_to "Continue setup", edit_campaign_character_path(campaign), class: "btn-secondary" %>
          <% elsif campaign.completed? || campaign.failed? %>
            <%= link_to "Show Results", campaign_path(campaign), class: "btn-secondary" %>
          <% else %>
            <%= link_to "Continue", campaign_path(campaign), class: "btn-primary" %>
          <% end %>
          <%= button_to "Delete", campaign_path(campaign), method: :delete, class: "btn-secondary text-red-400", data: { turbo_confirm: "Delete this campaign?" } %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @campaigns.empty? %>
    <p class="mt-12 text-center text-space-400">No campaigns yet. Create your first crew and ship.</p>
  <% end %>
</div>
