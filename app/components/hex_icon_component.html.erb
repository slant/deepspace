<% case icon %>
<% when "circle" %>
  <clipPath id="<%= clip_id %>">
    <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= pd / 2.0 %>" />
  </clipPath>
  <image href="/planets.png"
         x="<%= planet_x %>" y="<%= planet_y %>"
         width="<%= planet_sheet_size %>" height="<%= planet_sheet_size %>"
         clip-path="url(#<%= clip_id %>)"
         class="hex-icon-planet" />
<% when "square" %>
  <rect x="<%= cx - r %>" y="<%= cy - r %>" width="<%= r * 2 %>" height="<%= r * 2 %>" class="hex-icon hex-icon-square" />
<% when "home" %>
  <g transform="translate(<%= cx %>, <%= cy %>) scale(<%= (r / 12.0).round(4) %>) translate(-12, -12)" class="hex-icon-home">
    <path d="M5 10.5L12 4L19 10.5V20H15V15H9V20H5V10.5Z" />
  </g>
<% when "start" %>
  <g transform="translate(<%= cx %>, <%= cy %>) scale(<%= (r / 12.0).round(4) %>) translate(-12, -12)" class="hex-icon-start">
    <path d="M12 2L20 11H15V20H9V11H4L12 2Z" />
  </g>
<% when "beacon_store" %>
  <% bs_pd = pd * 0.75 %>
  <% bs_cy = cy - r * 0.2 %>
  <clipPath id="<%= clip_id('-bs') %>">
    <circle cx="<%= cx %>" cy="<%= bs_cy %>" r="<%= bs_pd / 2.0 %>" />
  </clipPath>
  <image href="/planets.png"
         x="<%= planet_x(cx, bs_pd) %>" y="<%= planet_y(bs_cy, bs_pd) %>"
         width="<%= planet_sheet_size(bs_pd) %>" height="<%= planet_sheet_size(bs_pd) %>"
         clip-path="url(#<%= clip_id('-bs') %>)"
         class="hex-icon-planet" />
  <rect x="<%= cx + r * 0.1 %>" y="<%= cy + r * 0.35 %>" width="<%= r * 0.8 %>" height="<%= r * 0.8 %>" class="hex-icon hex-icon-square" />
<% when "jump" %>
  <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= r * 1.1 %>" class="hex-icon hex-icon-jump" />
  <text x="<%= cx %>" y="<%= cy + 4 %>" class="hex-icon-jump-label">⇄</text>
<% end %>
